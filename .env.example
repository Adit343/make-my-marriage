# Copy to .env.local and fill in. Never commit real values.
# Use a separate dev database — never point local/dev at production (Architecture §41).

APP_URL=http://localhost:3000

MONGODB_URI=

# Encrypts the short-lived Google OAuth state/PKCE cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Encrypts the guest RSVP links so members can copy/re-share the same link. Required in
# production; if empty in development a key derived from SESSION_SECRET is used. Generate with the
# same command as SESSION_SECRET. Changing it later breaks "copy link" for links already stored
# (guests' own links keep working); rotate a guest's link to fix.
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vendor search (Phase 4). Server-side only; enable "Places API (New)" on the key and restrict it
# to that API. Leave empty to add vendors by typing the details instead.
GOOGLE_PLACES_API_KEY=

# Leave RESEND_API_KEY empty to log emails to the console in development.
RESEND_API_KEY=
EMAIL_FROM=

# Photo gallery storage (Phase 6): Cloudflare R2, a private bucket. Create the bucket, then an R2 API
# token limited to it (Object Read & Write). Set ALL FOUR or none. With none, photos are kept on
# disk in .local-storage for development and tests; production needs the four values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: where the development photo store keeps its files (default: .local-storage). Setting
# it ALSO lets a production build (next start) use the disk when R2 is not set, for trying one on
# your own machine; never set it on a host whose disk is temporary (Vercel).
LOCAL_STORAGE_DIR=
