# Copy to .env.local and fill in. Never commit real values.
# Use a separate dev database — never point local/dev at production (Architecture §41).

APP_URL=http://localhost:3000

MONGODB_URI=

# Encrypts the short-lived Google OAuth state/PKCE cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave RESEND_API_KEY empty to log emails to the console in development.
RESEND_API_KEY=
EMAIL_FROM=
