# Copy to .env.local and fill in. Never commit real values.
# Use a separate dev database — never point local/dev at production (Architecture §41).

APP_URL=http://localhost:3000

MONGODB_URI=

# Encrypts the short-lived Google OAuth state/PKCE cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Encrypts the guest RSVP links so members can copy/re-share the same link. Required in
# production; if empty in development a key derived from SESSION_SECRET is used. Generate with the
# same command as SESSION_SECRET. Changing it later breaks "copy link" for links already stored
# (guests' own links keep working); rotate a guest's link to fix.
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vendor search (Phase 4). Server-side only; enable "Places API (New)" on the key and restrict it
# to that API. Leave empty to add vendors by typing the details instead.
GOOGLE_PLACES_API_KEY=

# Leave RESEND_API_KEY empty to log emails to the console in development.
RESEND_API_KEY=
EMAIL_FROM=
